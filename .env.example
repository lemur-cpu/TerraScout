# TerraScout environment template. Copy to .env and fill locally.
# Never commit real credentials. Core terrain analysis does not require any key.

# Optional OpenTopography key (https://portal.opentopography.org/)
OPENTOPOGRAPHY_API_KEY=

# Optional NASA Earthdata login for granule download (search works without it)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Optional OpenAI-compatible API for LLM-backed agent prose.
# Leave empty to run geospatial/detection/skeptic tools without an LLM.
TERRASCOUT_LLM_BASE_URL=
TERRASCOUT_LLM_API_KEY=
TERRASCOUT_LLM_MODEL=

# Optional local Ollama host. Example: http://127.0.0.1:11434
OLLAMA_HOST=

# Cost and safety limits
TERRASCOUT_MAX_DOWNLOAD_MEGABYTES=50
TERRASCOUT_MAX_LLM_TOKENS=8000
TERRASCOUT_MAX_AGENT_ITERATIONS=8
TERRASCOUT_MAX_PARALLEL_JOBS=2
TERRASCOUT_MAX_SPEND_USD=0
TERRASCOUT_SEND_PRECISE_COORDINATES_TO_LLM=false

# Local data roots (gitignored)
TERRASCOUT_CACHE_DIR=./data/cache
TERRASCOUT_DATABASE_PATH=./var/terra_scout.sqlite3
TERRASCOUT_OUTPUT_DIR=./output
